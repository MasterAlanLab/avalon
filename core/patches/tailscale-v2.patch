+// StartManaged is explicit lifecycle control, independent of any business dial.
+// The application owns Close and a separate long-lived IPN subscription.
+func (t *Tailscale) StartManaged(available func() bool) (*local.Client, error) {
+	t.managedAvailable = available
+	// Auth URLs and server errors belong in controlled UI, never the core log.
+	t.server.UserLogf = func(string, ...any) {}
+	t.server.Logf = func(string, ...any) {}
+	if err := t.start(); err != nil {
+		return nil, err
+	}
+	return t.server.LocalClient()
+}
