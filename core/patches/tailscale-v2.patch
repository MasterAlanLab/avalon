@@ -1961,3 +1961,19 @@ func parseDomainRuleSet(domainSetName string, adapterName string, ruleProviders
 	}
 	return RP.NewRuleSet(domainSetName, adapterName, false, true)
 }
+
+// ParseRuntimeNetwork validates application-owned DNS/TUN overlays without
+// constructing, registering, or replacing unrelated proxies/providers.
+func ParseRuntimeNetwork(raw *RawConfig, providers map[string]P.RuleProvider, general General) (*DNS, LC.Tun, error) {
+	d, err := parseDNS(raw, providers)
+	if err != nil {
+		return nil, LC.Tun{}, err
+	}
+	if err = parseTun(raw.Tun, d, &general); err != nil {
+		return nil, LC.Tun{}, err
+	}
+	if !raw.IPv6 {
+		general.Tun.Inet6Address = nil
+	}
+	return d, general.Tun, nil
+}
