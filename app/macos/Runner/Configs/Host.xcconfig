AVALON_PUBLIC_NETWORK_VERSION = 1
MACOSX_DEPLOYMENT_TARGET = 13.0
AVALON_HOST_ENTITLEMENTS = Runner/Host.entitlements
AVALON_DEBUG_ENTITLEMENTS = Runner/DebugProfile.entitlements
