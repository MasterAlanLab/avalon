// Override these together when signing registered App IDs and App Groups.
#include "../../Flutter/ephemeral/Flutter-Generated.xcconfig"
AVALON_APP_GROUP = $(DEVELOPMENT_TEAM).app.getavalon.avalon
AVALON_TUNNEL_BUNDLE_ID = app.getavalon.avalon.PacketTunnel
